# Build context for this image must be `hub/` (not this directory), since the
# project depends on the sibling `shared` package via a local uv path source.
# See: `make build-chatbot-image` in the root Makefile.
FROM python:3.13-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# shared is copied one level up so the "../shared" path source in
# chatbot-service/pyproject.toml resolves correctly from /app.
COPY shared/ /shared/

COPY chatbot-service/pyproject.toml chatbot-service/uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-editable --no-dev

COPY chatbot-service/ /app/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable --no-dev

FROM python:3.13-slim

COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8080
CMD ["chatbot-service"]
